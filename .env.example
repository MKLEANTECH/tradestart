# Copy this file to .env and fill in your own Lean sandbox app credentials.
# Get these from https://portal.sandbox.leantech.me — never commit the real
# values (.env is git-ignored).

# Public app identifier — same value already lives in index.html client-side,
# it's not a secret, but keep it here too so the two stay in sync.
LEAN_APP_TOKEN=

# Real OAuth client secret — required, no default. The server refuses to
# start without this set.
LEAN_CLIENT_SECRET=

LEAN_AUTH_BASE_URL=https://auth.sandbox.leantech.me
LEAN_API_BASE_URL=https://sandbox.leantech.me

# Sandbox destination/source IDs specific to your Lean app — see the comments
# above these in server.js for how to obtain each one.
LEAN_PAYMENT_DESTINATION_ID=
LEAN_PAYOUT_SOURCE_ID=
LEAN_PAYOUT_DESTINATION_ID=
